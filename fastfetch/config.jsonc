{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": { "1": "white" },
        "padding": { "top": 1, "right": 4 }
    },

    "display": {
        "separator": " ",
        "color": {
            "keys": "white",
            "title": "white",
            "separator": "90",
            "output": "90"
        }
    },

    "modules": [
        { "type": "title", "color": { "user": "white", "at": "90", "host": "white" } },
        // { "type": "custom", "format": "────────────────────────", "outputColor": "90" },

        { "type": "os",       "key": "OS     " },
        { "type": "kernel",   "key": "KERNEL " },
        { "type": "uptime",   "key": "UP     " },
        { "type": "packages", "key": "PKGS   " },
        { "type": "shell",    "key": "SHELL  " },
        { "type": "wm",       "key": "WM     " },
        { "type": "terminal", "key": "TERM   " },
        { "type": "memory",   "key": "MEM    " },

        "break",
{
    "type": "custom",
    "format": "{#38;2;107;107;107}███ {#38;2;144;144;144}███ {#38;2;192;192;192}███ {#38;2;255;255;255}███ {#38;2;255;192;203}███"
}
    ]
}
