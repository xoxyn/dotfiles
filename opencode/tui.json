{
  "$schema": "https://opencode.ai/tui.json",
  "leader_timeout": 2000,
  "keybinds": {
    "leader": "ctrl+x",

    "input_move_left": "left,ctrl+b,alt+h",
    "input_move_right": "right,ctrl+f,alt+l",
    "input_move_up": "up,alt+k",
    "input_move_down": "down,alt+j",

    "input_word_forward": "alt+f,ctrl+right",
    "input_word_backward": "alt+b,ctrl+left",

    "session_list": "<leader>l",

    "input_line_home": "ctrl+a",
    "input_line_end": "ctrl+e",

    "input_newline": "shift+return,ctrl+return,alt+return",
    "input_delete_to_line_end": "alt+shift+d",

    "history_previous": "up,alt+k",
    "history_next": "down,alt+j",

    "dialog.select.prev": "up,ctrl+p,alt+k",
    "dialog.select.next": "down,ctrl+n,alt+j",
    "prompt.autocomplete.prev": "up,ctrl+p,alt+k",
    "prompt.autocomplete.next": "down,ctrl+n,alt+j",

    "messages_line_up": "ctrl+alt+y",
    "messages_line_down": "ctrl+alt+e",
    "messages_half_page_up": "ctrl+alt+u",
    "messages_half_page_down": "ctrl+alt+d",
    "messages_page_up": "pageup,ctrl+alt+b",
    "messages_page_down": "pagedown,ctrl+alt+f",
    "messages_first": "ctrl+g,home",
    "messages_last": "ctrl+alt+g,end"
  }
}
