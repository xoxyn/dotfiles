{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 0,

    "modules-left": [
        "custom/logo",
        "custom/sep",
        "hyprland/workspaces",
        "custom/arrow",
        "group/media"
    ],
    "modules-center": [],
    "modules-right": [
        "bluetooth",
        "network",
        "cpu",
        "memory",
        "battery",
        "pulseaudio",
        "tray",
        "clock"
    ],

    "custom/logo":  { "format": "⑃", "tooltip": false },
    "custom/sep":   { "format": "|", "tooltip": false },
    "custom/arrow": { "format": "▸", "tooltip": false },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": { "*": 4 }
    },

    "bluetooth": {
        "format": "[BT {status}]",
        "format-disabled": "",
        "format-off": "[BT OFF]",
        "format-connected": "[BT {num_connections}]",
        "format-connected-battery": "[BT {device_alias} {device_battery_percentage}%]",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "kitty -e bluetui",
        "on-click-right": "rfkill toggle bluetooth"
    },

    "network": {
        "format": "[NET {ifname}]",
        "format-wifi": "[WIFI {essid} {signalStrength}%]",
        "format-ethernet": "[ETH {ifname}]",
        "format-disconnected": "[NET DOWN]",
        "format-disabled": "[NET OFF]",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "networkmanager_dmenu",
        "on-click-right": "kitty -e nmtui",
        "max-length": 50
    },

    "cpu": {
        "interval": 2,
        "format": "[CPU {usage}%]",
        "on-click": "kitty -e btop"
    },

    "memory": {
        "interval": 30,
        "format": "[MEM {percentage}%]",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G used",
        "on-click": "kitty -e htop"
    },

    "battery": {
        "bat": "BAT0",
        "interval": 60,
        "format": "[BAT {capacity}%]",
        "format-charging": "[BAT {capacity}% CHG]",
        "format-plugged": "[BAT {capacity}% AC]",
        "states": { "warning": 25, "critical": 10 },
        "tooltip-format": "{timeTo}",
        "on-click": "notify-send \"Battery\" \"$(upower -i /org/freedesktop/UPower/devices/battery_BAT0 | grep -E 'state|percentage|time to|energy-rate' | sed 's/^ *//')\""
    },

    "pulseaudio": {
        "format": "[VOL {volume}%]",
        "format-muted": "[VOL MUTE]",
        "scroll-step": 1,
        "ignored-sinks": ["Easy Effects Sink"],
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "clock": {
        "format": "[{:%I:%M %p}]",
        "format-alt": "[{:%a %d %b %Y %I:%M %p}]",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "first-day-of-week": 1,
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#d8d2c4'><b>{}</b></span>",
                "days":     "<span color='#d8d2c4'>{}</span>",
                "weeks":    "<span color='#a8612f'>W{}</span>",
                "weekdays": "<span color='#a8612f'><b>{}</b></span>",
                "today":    "<span color='#ffffff'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "group/media": {
        "orientation": "horizontal",
        "modules": [
            "custom/media-animation",
            "custom/media-now-playing",
            "custom/media-time"
        ]
    },

    "custom/media-now-playing": {
        "exec": "~/.config/waybar/custom_modules/media/media-now-playing.sh",
        "format": "[{}]",
        "escape": true,
        "tooltip": false,
        "on-click": "playerctl play-pause",
        "on-click-middle": "playerctl previous",
        "on-click-right": "playerctl next"
    },

    "custom/media-animation": {
        "exec": "~/.config/waybar/custom_modules/media/media-animation.sh",
        "tooltip": false
    },

    "custom/media-time": {
        "exec": "~/.config/waybar/custom_modules/media/media-time.sh",
        "format": "[{}]",
        "escape": true,
        "interval": 1,
        "tooltip": false
    },

    "tray": {
        "icon-size": 13,
        "spacing": 6
    }
}
